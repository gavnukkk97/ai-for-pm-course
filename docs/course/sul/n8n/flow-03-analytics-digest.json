{
  "name": "SUL N6 — analytics digest schedule",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-003",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 280]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1"
            }
          ]
        }
      },
      "id": "schedule-003",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 500]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "product_name",
              "value": "={{ $json.product_name || 'Ритм' }}",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "period_label",
              "value": "={{ $json.period_label || 'weekly' }}",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "metrics_blob",
              "value": "={{ $json.metrics_blob || $json.body || '| metric | value | window |\\n| paywall_cv | 5.4% | 7d |\\n| depth_ge3 | 27% | 7d |\\n| early_pw_share | 41% | 7d |' }}",
              "type": "string"
            },
            {
              "id": "c4",
              "name": "definitions_blob",
              "value": "={{ $json.definitions_blob || 'depth_ge3 = D7 habit depth ≥3; paywall_cv = pays/paywall_views; early_pw_share = guardrail. Do not invent CAC.' }}",
              "type": "string"
            },
            {
              "id": "c5",
              "name": "ask",
              "value": "={{ $json.ask || 'Еженедельный analytics digest: что изменилось, риски, 3 вопроса человеку. Только по метрикам и DEFINITIONS. Язык: русский.' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-normalize-003",
      "name": "Normalize Metrics",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [280, 400]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Product: {{ $json.product_name }}\nPeriod: {{ $json.period_label }}\nAsk: {{ $json.ask }}\n\nDEFINITIONS:\n{{ $json.definitions_blob }}\n\nMETRICS TABLE / STATUS:\n{{ $json.metrics_blob }}\n\nMarkdown:\n1) Snapshot (только числа из входа)\n2) Что требует внимания\n3) 3 вопроса человеку-судье\n4) Assumptions / gaps\nЗапрет: выдумывать CAC, platform split, релизы.",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "Ты analytics chief-of-staff. Работаешь только по DEFINITIONS и таблице. Если данных нет — пиши «нет во входе». Человек = финальный судья. Язык: русский."
            }
          ]
        }
      },
      "id": "llm-chain-003",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [560, 400]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.1
        }
      },
      "id": "chat-model-003",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [560, 620],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_IN_N8N_UI",
          "name": "OpenAI (set in n8n UI — do not commit secrets)"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "w1",
              "name": "artifact_markdown",
              "value": "=# Analytics digest · {{ $('Normalize Metrics').item.json.product_name }} · {{ $('Normalize Metrics').item.json.period_label }}\\n\\n_Generated by n8n flow #3 (schedule analytics digest)_\\n\\n{{ $json.text || $json.response || $json.output || JSON.stringify($json) }}\\n",
              "type": "string"
            },
            {
              "id": "w2",
              "name": "suggested_path",
              "value": "runs/n8n/digest-metrics-{{ $('Normalize Metrics').item.json.period_label }}.md",
              "type": "string"
            },
            {
              "id": "w3",
              "name": "data_class",
              "value": "synthetic_or_internal_ops",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-wrap-003",
      "name": "Wrap Metrics Digest",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, 400]
    }
  ],
  "pinData": {},
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Normalize Metrics", "type": "main", "index": 0 }]]
    },
    "Schedule Trigger": {
      "main": [[{ "node": "Normalize Metrics", "type": "main", "index": 0 }]]
    },
    "Normalize Metrics": {
      "main": [[{ "node": "Basic LLM Chain", "type": "main", "index": 0 }]]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [[{ "node": "Basic LLM Chain", "type": "ai_languageModel", "index": 0 }]]
    },
    "Basic LLM Chain": {
      "main": [[{ "node": "Wrap Metrics Digest", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "sul-n6-flow03-v1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "course": "ai-for-pm",
    "milestone": "N6-S4",
    "notes": "Schedule + Manual. Pass metrics_blob and definitions_blob. No secrets. Human is final judge."
  },
  "tags": [
    {
      "name": "sul-n6"
    },
    {
      "name": "analytics-digest"
    }
  ]
}
