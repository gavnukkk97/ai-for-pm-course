{
  "name": "SUL S0 — trigger to LLM artifact",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sul-s0-summary",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 520],
      "webhookId": "sul-s0-summary-placeholder"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "product_name",
              "value": "={{ $json.product_name || 'My Product' }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "ask",
              "value": "={{ $json.ask || 'Сводка бэклога: статусы, блокеры, top-3 риска. Не выдумывай пункты.' }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "backlog_snippet",
              "value": "={{ $json.backlog_snippet || '| id | title | status | owner |\\n| B1 | Example | todo | |' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-normalize-001",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [280, 400]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Product: {{ $json.product_name }}\nAsk: {{ $json.ask }}\n\nBacklog:\n{{ $json.backlog_snippet }}\n\nОтветь Markdown: (1) таблица статусов (2) blockers (3) top-3 риска. Пометь assumptions.",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "Ты chief-of-staff продакта. Работаешь только по данным входа. Не выдумывай backlog items. Язык: русский."
            }
          ]
        }
      },
      "id": "llm-chain-001",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [560, 400]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "chat-model-001",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [560, 620],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_IN_N8N_UI",
          "name": "OpenAI (set in n8n UI — do not commit secrets)"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "w1",
              "name": "artifact_markdown",
              "value": "=# SUL S0 summary\\n\\n_Generated by n8n flow #1_\\n\\n{{ $json.text || $json.response || $json.output || JSON.stringify($json) }}\\n",
              "type": "string"
            },
            {
              "id": "w2",
              "name": "data_class",
              "value": "synthetic_or_internal_ops",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-wrap-001",
      "name": "Wrap Markdown",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, 400]
    }
  ],
  "pinData": {},
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Normalize Input", "type": "main", "index": 0 }]]
    },
    "Webhook": {
      "main": [[{ "node": "Normalize Input", "type": "main", "index": 0 }]]
    },
    "Normalize Input": {
      "main": [[{ "node": "Basic LLM Chain", "type": "main", "index": 0 }]]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [[{ "node": "Basic LLM Chain", "type": "ai_languageModel", "index": 0 }]]
    },
    "Basic LLM Chain": {
      "main": [[{ "node": "Wrap Markdown", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "sul-s0-flow01-v1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "course": "ai-for-pm",
    "milestone": "S0",
