{
  "name": "SUL N3 — signals to digest",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-002",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 280]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "schedule-002",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 500]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sul-signals-digest",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-002",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 720],
      "webhookId": "sul-signals-digest-placeholder"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "product_name",
              "value": "={{ $json.product_name || 'Ритм' }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "period_label",
              "value": "={{ $json.period_label || 'last-7d' }}",
              "type": "string"
            },
            {
              "id": "b3",
              "name": "signals_blob",
              "value": "={{ $json.signals_blob || $json.body || '# inbox signals\\n- (paste evidence/inbox notes here)' }}",
              "type": "string"
            },
            {
              "id": "b4",
              "name": "ask",
              "value": "={{ $json.ask || 'Сводка сигналов discovery: top-5 фактов, дыры в evidence, какие гипотезы затронуты. Не выдумывай факты вне входа. Язык: русский.' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-normalize-002",
      "name": "Normalize Signals",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [280, 480]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Product: {{ $json.product_name }}\nPeriod: {{ $json.period_label }}\nAsk: {{ $json.ask }}\n\nSignals / evidence inbox:\n{{ $json.signals_blob }}\n\nФормат Markdown:\n1) Top-5 сигналов (факт → вывод → уверенность)\n2) Дыры evidence\n3) Гипотезы H__ которых касается\n4) Assumptions (явно)",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "Ты research ops для продакта. Только по данным входа. Помечай live/synthetic/assumption если видно из текста. Не выдумывай цитаты пользователей. Язык: русский."
            }
          ]
        }
      },
      "id": "llm-chain-002",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [560, 480]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "chat-model-002",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [560, 700],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_IN_N8N_UI",
          "name": "OpenAI (set in n8n UI — do not commit secrets)"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "w1",
              "name": "artifact_markdown",
              "value": "=# Discovery digest · {{ $('Normalize Signals').item.json.product_name }} · {{ $('Normalize Signals').item.json.period_label }}\\n\\n_Generated by n8n flow #2 (signals → digest)_\\n\\n{{ $json.text || $json.response || $json.output || JSON.stringify($json) }}\\n",
              "type": "string"
            },
            {
              "id": "w2",
              "name": "suggested_path",
              "value": "runs/n8n/digest-signals-{{ $('Normalize Signals').item.json.period_label }}.md",
              "type": "string"
            },
            {
              "id": "w3",
              "name": "data_class",
              "value": "synthetic_or_internal_ops",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-wrap-002",
      "name": "Wrap Digest Markdown",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, 480]
    }
  ],
  "pinData": {},
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Normalize Signals", "type": "main", "index": 0 }]]
    },
    "Schedule Trigger": {
      "main": [[{ "node": "Normalize Signals", "type": "main", "index": 0 }]]
    },
    "Webhook": {
      "main": [[{ "node": "Normalize Signals", "type": "main", "index": 0 }]]
    },
    "Normalize Signals": {
      "main": [[{ "node": "Basic LLM Chain", "type": "main", "index": 0 }]]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [[{ "node": "Basic LLM Chain", "type": "ai_languageModel", "index": 0 }]]
    },
    "Basic LLM Chain": {
      "main": [[{ "node": "Wrap Digest Markdown", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "sul-n3-flow02-v1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "course": "ai-for-pm",
    "milestone": "N3-S2",
    "notes": "Replace OpenAI credential in UI. For file read from disk use self-hosted Read/Write nodes; Cloud: pass signals_blob via Manual/Webhook. No API keys in this file."
  },
  "tags": [
    {
      "name": "sul-n3"
    },
    {
      "name": "digest"
    }
  ]
}
